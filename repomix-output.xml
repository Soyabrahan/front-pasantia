            </SidebarContent>
            <SidebarFooter className="p-4 border-t border-white/10 mt-auto">
                <div className="flex flex-col gap-4">
                    <div className="flex items-center px-1 overflow-hidden group-data-[collapsible=icon]:hidden justify-between">
